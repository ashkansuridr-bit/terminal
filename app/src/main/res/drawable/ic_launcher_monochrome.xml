<?xml version="1.0" encoding="utf-8"?>
<!--
  Monochrome (themed-icon) variant of the prompt mark (>_) paired with a Persian ogee arch holding three tile diamonds.
  Adaptive-icon geometry: the 108dp viewport is cropped to a 72dp safe zone by launcher
  masks, so every element here stays inside roughly 26..86 rather than reaching the tile
  edge the way the source artwork does.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">

    <!-- prompt chevron -->
    <path android:fillColor="#FFFFFFFF"
        android:pathData="M26,34 L43,54 L26,74 L32,80 L54,54 L32,28 Z"/>

    <!-- cursor underscore -->
    <path android:fillColor="#FFFFFFFF"
        android:pathData="M60,71 L84,71 A3.5,3.5 0 0 1 84,78 L60,78 A3.5,3.5 0 0 1 60,71 Z"/>

    <!-- ogee arch -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M59,53 L59,43 C59,36 63,32 67,29 C70,27 72,25 73,22 C74,25 76,27 79,29 C83,32 87,36 87,43 L87,53"/>

    <!-- tile diamonds -->
    <path android:fillColor="#FFFFFFFF"
        android:pathData="M73,32 L77,36 L73,40 L69,36 Z"/>
    <path android:fillColor="#FFFFFFFF"
        android:pathData="M66,41 L69.5,44.5 L66,48 L62.5,44.5 Z"/>
    <path android:fillColor="#FFFFFFFF"
        android:pathData="M80,41 L83.5,44.5 L80,48 L76.5,44.5 Z"/>
</vector>
