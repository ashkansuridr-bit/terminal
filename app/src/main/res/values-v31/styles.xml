<resources>
    <!--
      Android 12+ can run an animated splash icon. The duration must match what the
      animation actually takes, or the system cuts it off mid-draw.
    -->
    <style name="SplashTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FF0B0F14</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_animated</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>
</resources>
